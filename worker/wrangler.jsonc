{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "okf-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // One SQLite-backed Durable Object per library (spec: Backend architecture).
  "durable_objects": {
    "bindings": [{ "name": "LIBRARY", "class_name": "Library" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Library"] }],

  // Account layer (users, libraries, tokens).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "okf-accounts",
      "database_id": "c36c4e44-2d34-4053-9fee-3ac7f1ad6c0c",
      "migrations_dir": "migrations"
    }
  ],

  // Attachment blobs (blobs/<sha256>) and exports.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "okf-blobs" }]
}
