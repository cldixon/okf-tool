{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "okf-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public: outbound fetch cannot reach private addresses; required for
  // OAuth Client ID Metadata Documents (the Worker fetches a URL an MCP client names).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // One SQLite-backed Durable Object per library (spec: Backend architecture).
  "durable_objects": {
    "bindings": [{ "name": "LIBRARY", "class_name": "Library" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Library"] }],

  // Account layer (users, libraries, tokens).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "okf-accounts",
      "database_id": "c36c4e44-2d34-4053-9fee-3ac7f1ad6c0c",
      "migrations_dir": "migrations"
    }
  ],

  // Attachment blobs (blobs/<sha256>) and exports.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "okf-blobs" }],

  // OAuth clients and grants for MCP apps (Cloudflare's OAuth provider library).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "0b8fe9060b9645749d11d6083793295a" }],

  // Nightly exports (exports/<library id>/<date>/) older than this are deleted; the newest stays.
  "vars": { "EXPORT_RETENTION_DAYS": "30" }

  // Secrets, set per deployment (spec: Deployment): ACCESS_TEAM_DOMAIN and ACCESS_AUD, from the
  // Cloudflare Access application that covers /app/*. For local dev, see .dev.vars.example.
}
