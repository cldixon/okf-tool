{
  "name": "okf-tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "bun run --filter worker dev",
    "deploy": "bun run --filter worker deploy",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "seed": "bun run --filter worker seed",
    "gate": "bun run --filter worker gate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
