{
  "name": "tempra",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "worker",
    "worker/render",
    "design",
    "editor",
    "app"
  ],
  "scripts": {
    "postinstall": "bun run --filter @tempra/app build",
    "dev": "bun run --filter worker dev",
    "deploy": "bun run --filter worker deploy",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "seed": "bun run --filter worker seed",
    "gate": "bun run --cwd worker gate",
    "site-shots": "bun run --cwd worker site-shots",
    "logs": "bun run --filter worker logs",
    "costs": "bun run --filter worker costs",
    "preview": "bun run --filter worker preview",
    "admin": "bun run --filter worker admin",
    "agents": "bun run --filter worker agents",
    "mcp": "bun run --filter worker mcp"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
