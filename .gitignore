# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Dependencies (bun)
node_modules/
.bun/

# Build / tooling output
dist/
# except the design package's generated output, which the app and the site import as is
!design/dist/
coverage/
*.tsbuildinfo
.cache/

# Cloudflare: local dev state (cf dev runs the Wrangler bundler, which keeps it in .wrangler/)
.wrangler/
# bun run gate: a throwaway cf dev project per run (worker/.gate/run-*)
.gate/
# bun run site-shots: the same, for the landing page's screenshots (worker/.site-shots/run-*)
.site-shots/
.dev.vars
.dev.vars.*
!.dev.vars.sample

# Env and secrets
.env
# bun run mcp: tokens it made for preview libraries
.mcp-tokens.json
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
bun-debug.log*

# cf CLI: build output and generated types (`cf workers types`, run by `bun run typecheck`)
.cloudflare/

# Astro (site/): generated types
.astro/
.svelte-check/
