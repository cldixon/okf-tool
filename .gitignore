# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Dependencies (bun)
node_modules/
.bun/

# Build / tooling output
dist/
coverage/
*.tsbuildinfo
.cache/

# Cloudflare: local dev state (cf dev runs the Wrangler bundler, which keeps it in .wrangler/)
.wrangler/
# bun run gate: a throwaway cf dev project per run (worker/.gate/run-*)
.gate/
.dev.vars
.dev.vars.*
!.dev.vars.sample

# Env and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
bun-debug.log*

# cf CLI: build output and generated types (`cf workers types`, run by `bun run typecheck`)
.cloudflare/
