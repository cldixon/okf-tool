---
/**
 * Every page: a skip link, the wordmark and the way into the app over a hairline, the page as a
 * plain column, and the footer's links. Flat like the app (TEMPRA-126), all of it from the shared
 * design package's public pages (`public.css`); the site adds no styles of its own.
 */
import "@tempra/design/tempra.css";
import favicon from "@tempra/design/favicon.svg?url";
import { markSvg } from "@tempra/design/mark";
import { APP, SITE_NAME } from "../site";

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// The page's one URL, with no trailing slash and no .html (pages build to terms.html; W-9).
const url = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="public">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="public-head">
      <a class="wordmark mark-lockup" href="/"><Fragment set:html={markSvg({ small: true })} />Tempra</a>
      <nav class="public-nav" aria-label="Main">
        <a class="button primary" href={`${APP}/sign-in`}>Join now</a>
      </nav>
    </header>
    <main id="main" class="public-main">
      <slot />
    </main>
    <footer class="public-foot">
      <nav aria-label="Footer">
        <ul role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href={`${APP}/sign-in`}>Join now</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
