---
/**
 * Every page: a skip link, the large lockup and the one way into the app (Sign in), the page, and
 * the footer's links (TEMPRA-286, the site's frame: `.public.site`). Flat like the app
 * (TEMPRA-126), all of it from the shared design package's public pages (`public.css`); the site
 * adds no styles of its own. The landing page fills the window (`landing`).
 */
import "@tempra/design/tempra.css";
import favicon from "@tempra/design/favicon.svg?url";
import { markSvg } from "@tempra/design/mark";
import { APP, SITE_NAME } from "../site";

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** The landing page: one window, its doc in place of the plain column. */
  landing?: boolean;
  /** A document with its contents beside it (Terms, Privacy): a wider column. */
  doc?: boolean;
}

const { title, description, noindex = false, landing = false, doc = false } = Astro.props;
// The page's one URL, with no trailing slash and no .html (pages build to terms.html; W-9).
const url = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class:list={["public", "site", { landing, doc }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="public-head">
      <a class="wordmark mark-lockup" href="/"><Fragment set:html={markSvg({ small: true })} />Tempra</a>
      <nav class="public-nav" aria-label="Main">
        <a class="button primary" href={`${APP}/sign-in`}>Sign in</a>
      </nav>
    </header>
    <main id="main" class="public-main">
      <slot />
    </main>
    <footer class="public-foot">
      <nav aria-label="Footer">
        <ul role="list">
          <li><a href="/terms">Terms</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
