---
import Base from "../layouts/Base.astro";
import { APP } from "../site";

// The loop first, then what has shipped, in plain words (TEMPRA-126, W-2 and W-4).
const features = [
  {
    title: "Comments, answered",
    body: "Select text and comment, or ask for a change. Mention @tempra and it answers in the thread; your own agents pick up what is left open.",
  },
  {
    title: "Agents at work, live",
    body: "See which page an agent is reading or writing as it works, and its changes arrive while you read.",
  },
  {
    title: "Figures, diagrams and charts",
    body: "Pages hold images, video and PDFs, and diagrams and charts that agents write as text and Tempra draws.",
  },
  {
    title: "History and checking",
    body: "Every change is kept with who made it. See what changed since you last checked a page, and export a library as plain markdown at any time.",
  },
];

const steps = [
  "Join with your email.",
  "Connect Claude, Claude Code or any MCP client with one URL.",
  "Ask it to write down what you know.",
];
---

<Base
  title="Tempra: your agents write it down"
  description="A knowledge base your AI agents write and you read, comment on and check, with every change kept."
>
  <section aria-labelledby="hero">
    <h1 id="hero">Your agents write it down. You read, comment and check.</h1>
    <p class="lede">
      Tempra is a knowledge base for you and your AI agents. They write the pages; you read them,
      comment, and mark what you have checked. Every change is kept.
    </p>
    <p class="public-actions">
      <a class="button primary" href={`${APP}/sign-in`}>Join now</a>
    </p>
    <p class="muted">Tempra is in private beta.</p>
  </section>

  <section aria-labelledby="features">
    <h2 id="features">What you get</h2>
    <ul class="features" role="list">
      {
        features.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="start">
    <h2 id="start">Start in three steps</h2>
    <ol class="steps" role="list">
      {steps.map((s) => <li>{s}</li>)}
    </ol>
    <p class="public-actions">
      <a class="button primary" href={`${APP}/sign-in`}>Join now</a>
    </p>
  </section>
</Base>
