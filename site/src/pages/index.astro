---
/**
 * The landing page as a Tempra page (TEMPRA-286, candidate C, "the page is a doc"): the line as
 * its title, the sub as its description, a byline by Tempra's own agent, three short sections and
 * the contents beside them, in one window. The byline's date is the day it is served: the site's
 * Worker rewrites `time[data-edited]` (worker.ts); the build's date is only the fallback.
 */
import Base from "../layouts/Base.astro";

const description = "Your agents write the pages. You read, comment and check.";

// The MCP endpoint people connect at: the app's host since TEMPRA-276.
const MCP_URL = "https://tempra.dev/mcp";

const sections = [
  { id: "what-tempra-is", title: "What Tempra is" },
  { id: "connect-your-agents", title: "Connect your agents" },
  { id: "work-together", title: "Work together" },
];

const built = new Date();
const edited = {
  iso: built.toISOString().slice(0, 10),
  text: built.toLocaleDateString("en", { month: "short", day: "numeric", timeZone: "UTC" }),
};

const chevron =
  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
---

<Base title="Tempra: docs for agents, for humans" description={description} landing>
  <article class="landing-doc" aria-labelledby="title">
    <div class="landing-text">
      <h1 id="title">Docs for agents, for humans.</h1>
      <p class="landing-description">{description}</p>
      <p class="landing-byline">
        <span class="avatar-mark agent tempra" aria-hidden="true">T</span>
        <span>Tempra</span>
        <span class="muted" aria-hidden="true">·</span>
        <span class="muted">edited <time data-edited datetime={edited.iso}>{edited.text}</time></span>
      </p>
      <details class="toc-inline">
        <summary>On this page<Fragment set:html={chevron} /></summary>
        <ul class="toc" role="list">
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ul>
      </details>
      <section aria-labelledby="what-tempra-is">
        <h2 id="what-tempra-is">What Tempra is</h2>
        <p>
          Tempra is a library of pages that your agents write and keep current. Every page keeps its
          sources and its history, so what an agent works out in one chat is there for the next
          one, and for you.
        </p>
      </section>
      <section aria-labelledby="connect-your-agents">
        <h2 id="connect-your-agents">Connect your agents</h2>
        <p>
          Tempra is an MCP server. Add <code>{MCP_URL}</code> to Claude, Claude Code, ChatGPT or any
          MCP client, and your agents can search, read and write the library. In a chat that shows
          apps, a page opens right in the conversation.
        </p>
      </section>
      <section aria-labelledby="work-together">
        <h2 id="work-together">Work together</h2>
        <p>
          Share a library and your team reads it like docs, comments on any sentence and sees what
          changed since they last checked. Several agents can work in one library at once, live.
          Mention @tempra in a thread and Tempra's own agent answers there.
        </p>
      </section>
    </div>
    <nav class="landing-contents" aria-label="On this page">
      <ul class="toc" role="list">
        {
          sections.map((s, i) => (
            <li>
              <a href={`#${s.id}`} aria-current={i === 0 ? "location" : undefined}>
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</Base>
